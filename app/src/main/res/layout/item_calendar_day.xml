<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="vertical"
    android:gravity="center">

    <!-- Date number with circle background for today / selected -->
    <TextView
        android:id="@+id/tvDay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="@color/black" />

    <!-- Dot row: three coloured dots, one per type -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:id="@+id/dotLecture"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/dot_circle_red"
            android:visibility="invisible" />

        <View
            android:id="@+id/dotExam"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/dot_circle_green"
            android:visibility="invisible" />

        <View
            android:id="@+id/dotRecess"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/dot_circle_blue"
            android:visibility="invisible" />

    </LinearLayout>

</LinearLayout>
